# Empty integration values disable outbound requests. No mock success fallback exists.
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
# At least 32 random characters. Server gateway access only; not family/wallet authentication.
# Keep this token server-side. Never put it in NEXT_PUBLIC_* or browser code.
API_GATEWAY_TOKEN=
ZERION_API_KEY=
NANSEN_API_KEY=
# Deploy the contracts and run the indexer before setting these. Zero addresses are rejected.
STREAM_VAULT_ADDRESS=
ENVIO_GRAPHQL_URL=
ENVIO_ADMIN_SECRET=
# Optional untrusted natural-language proposals. All four values required.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Kimi example base URL: https://api.moonshot.ai/v1
# Qwen Singapore example: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Choose a current supported model from your provider console. Model availability is not assumed.
# Mercuryo funding and Chainlink CRE/FX are not implemented; no secret enables them.

