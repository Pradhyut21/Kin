# No Kin deployment is assumed. Fill these after separately deploying and wiring it.
VITE_STREAM_VAULT_ADDRESS=
VITE_POLICY_MODULE_ADDRESS=
VITE_APPROVAL_QUEUE_ADDRESS=
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Optional proposal-only backend; no backend credentials are needed for the local demo.
VITE_API_URL=http://localhost:3001
# Copy to frontend/.env.local and restart Vite. Never include private keys or provider secrets in VITE_*.
# Monad testnet 10143; token checked at runtime against official Agora testnet AUSD.
# https://docs.monad.xyz/ai/current-facts
# https://docs.agora.finance/developer/contract-deployments
